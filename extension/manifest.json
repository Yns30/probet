{
  "manifest_version": 3,
  "name": "ProBet CS2",
  "version": "2.2.0",
  "description": "Assistant de paris CS2 en direct : lit la page de match HLTV ouverte et calcule les probabilités en temps réel.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://www.hltv.org/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Ouvrir ProBet" },
  "side_panel": { "default_path": "panel.html" },
  "content_scripts": [
    {
      "matches": ["https://www.hltv.org/matches/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.hltv.org/matches/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["hltv.js", "engine.js"], "matches": ["https://www.hltv.org/*"] }
  ]
}
